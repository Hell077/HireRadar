# Copy to .env before running docker compose up --build.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RUSTFS_ACCESS_KEY=replace-with-an-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=hireradar-resumes
# Generate with: openssl rand -base64 32
JWT_PRIVATE_KEY=replace-with-a-base64-encoded-32-byte-seed
APP_PUBLIC_URL=http://localhost:3000
# Optional until a Telegram bot is configured; set all three values together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
OPERATOR_API_TOKEN=
